# LLM 백엔드: vllm (기본) | ollama
# vLLM = 사내 qwen3-32b-finance. thinking을 끄고 호출한다(끄지 않으면 3~10배 느림).
# vLLM이 죽으면 LLM_BACKEND=ollama로 바꿔 대체 경로를 쓴다.
LLM_BACKEND=vllm
LLM_BASE_URL=http://192.168.10.7/v1
LLM_MODEL=qwen3-32b-finance
LLM_API_KEY=
# 접근 게이트(선택). 값을 넣으면 전 화면·API가 이 공유 비밀번호로 잠긴다.
# 비워두면 게이트 비활성 = 공개(기본 PoC 동작).
APP_PASSWORD=
# 의미검색 임베딩 백엔드(사내 Ollama, embeddinggemma 768차원)
EMBED_URL=http://192.168.0.152:11434
EMBED_MODEL=embeddinggemma

# LightRAG PoC 프록시 (/lightrag 테스트 화면). 개발 PC는 NodePort로 붙는다.
LIGHTRAG_URL=http://192.168.0.103:31930
LIGHTRAG_API_KEY=lightrag-poc-sj-2026
