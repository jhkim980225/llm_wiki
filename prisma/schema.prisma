generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 인증 · 워크스페이스 ─────────────────────────────────────────────
// 상태·역할은 리포 관행대로 String — 값 검증은 zod가 한다.
// status ∈ ACTIVE·LOCKED·DISABLED, role ∈ OWNER·WORKSPACE_ADMIN·EDITOR·VIEWER

model User {
  id                String    @id @default(uuid())
  loginId           String    @unique // 소문자 정규화 저장 (lib/auth/password.ts)
  passwordHash      String // bcrypt cost 12
  displayName       String    @default("")
  status            String    @default("ACTIVE")
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  mustChangePassword Boolean  @default(false)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  memberships WorkspaceMember[]
  sessions    UserSession[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE") // ACTIVE · ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]
}

model WorkspaceMember {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("VIEWER")
  isDefault   Boolean   @default(false)
  joinedAt    DateTime  @default(now())

  @@id([workspaceId, userId])
  // 사용자당 기본 워크스페이스 하나 — 부분 유니크 인덱스는 마이그레이션 SQL에서 만든다
  @@index([userId])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String?
  // 토큰 원문은 저장하지 않는다 — SHA-256 hex만
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model LoginAuditLog {
  id            BigInt   @id @default(autoincrement())
  userId        String?
  workspaceId   String?
  loginId       String
  // LOGIN_SUCCESS · LOGIN_FAILED · ACCOUNT_LOCKED · LOGOUT · PASSWORD_CHANGED · PASSWORD_RESET
  eventType     String
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([loginId, createdAt])
}

model Page {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  pageType       String    @default("concept")
  status         String    @default("published")
  content        String    @default("")
  summary        String    @default("")
  aliases        String[]  @default([])
  folderId       String?
  folder         Folder?   @relation(fields: [folderId], references: [id])
  sortOrder      Int       @default(0)
  inLinks        String[]  @default([])
  outLinks       String[]  @default([])
  metadata       Json      @default("{}")
  version        Int       @default(1)
  lastEditSource String    @default("user")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  // 의미검색용 임베딩(embeddinggemma 768차원). pgvector 타입이라 Prisma는 Unsupported로 두고
  // 읽기/쓰기·검색은 $queryRaw로 한다. hnsw 인덱스는 마이그레이션 SQL에서 직접 만든다.
  embedding      Unsupported("vector(768)")?

  revisions PageRevision[]

  @@index([pageType])
  @@index([folderId])
  @@index([deletedAt])
  @@index([title])
}

model PageRevision {
  id         String   @id @default(uuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug       String
  version    Int
  title      String
  content    String
  summary    String
  pageType   String
  status     String
  editSource String   @default("user")
  createdAt  DateTime @default(now())

  @@unique([pageId, version])
  @@index([slug])
}

model Folder {
  id        String    @id @default(uuid())
  parentId  String?
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]  @relation("FolderTree")
  name      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // 휴지통 — 문서와 같은 soft delete. 7일 지나면 퍼지된다 (lib/trash.ts)
  deletedAt DateTime?

  pages Page[]

  @@index([parentId])
  @@index([deletedAt])
}

// 일반 채팅(/chat) 대화 이력. 사용자·워크스페이스 스코프.
// User/Workspace와는 스칼라 FK로만 잇는다(모델 back-relation 미추가) — 격리 유지.
model ChatConversation {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  title       String        @default("새 대화")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]

  @@index([userId, workspaceId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'user' | 'assistant'
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// WBS(업무분해) 계획 + LLM이 채우는 주간일정. 사용자·워크스페이스 스코프.
// User/Workspace와는 스칼라 FK로만 잇는다(격리).
model WbsPlan {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  title       String    @default("새 WBS")
  weekStart   String? // 'YYYY-MM-DD' (선택)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       WbsTask[]

  @@index([userId, workspaceId, updatedAt])
}

model WbsTask {
  id           String          @id @default(uuid())
  planId       String
  plan         WbsPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  wbsCode      String? // 예: '1.2'
  title        String
  assignee     String?
  startDate    String? // 'YYYY-MM-DD'
  endDate      String?
  durationDays Int?
  sortOrder    Int             @default(0)
  entries      ScheduleEntry[]

  @@index([planId, sortOrder])
}

// 채우기 배치의 진행상태(플랜당 1개, 폴링용). 재실행하면 덮어쓴다.
model WbsFillJob {
  id         String    @id @default(uuid())
  planId     String    @unique
  status     String    @default("running") // running | done | error
  total      Int       @default(0)
  done       Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// 셀 = (task, date). LLM 배치가 채운다. 클릭하면 detail(markdown)을 보여준다.
model ScheduleEntry {
  id        String   @id @default(uuid())
  taskId    String
  task      WbsTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date      String // 'YYYY-MM-DD'
  summary   String // 셀에 표시되는 한 줄
  detail    String   @default("") // 클릭 시 상세(markdown)
  status    String   @default("filled") // pending | filled
  source    String   @default("llm") // llm | user
  createdAt DateTime @default(now())

  @@unique([taskId, date])
  @@index([taskId, date])
}

// FLOW — 프롬프트+템플릿+저장폴더를 등록해 두고 주기 실행하는 배치 작업.
// 실행 엔진은 lib/flow/run.ts(runFlow). tick(/api/flow/tick)이 due 작업을 돌린다.
model FlowTask {
  id             String    @id @default(uuid())
  userId         String
  workspaceId    String
  title          String
  prompt         String // runFlow의 instruction
  templateSlug   String // 양식 문서
  targetFolderId String? // 저장 폴더 (없으면 targetFolderName으로 해석)
  targetFolderName String?
  // 주기: 'weekly' 고정 + 요일(0=일 ~ 6=토) + 시(0~23). 요구가 "주 1회 월요일"이라 주간만.
  scheduleWeekday Int      @default(1)
  scheduleHour    Int      @default(9)
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  deletedAt      DateTime? // soft delete — 리포 규칙
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  runs           FlowRun[]

  @@index([workspaceId, deletedAt, nextRunAt])
}

model FlowRun {
  id         String    @id @default(uuid())
  flowId     String
  flow       FlowTask  @relation(fields: [flowId], references: [id], onDelete: Cascade)
  status     String    @default("running") // running | done | error
  trigger    String    @default("schedule") // schedule | manual
  resultSlug String?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([flowId, startedAt])
  @@index([startedAt])
}
